<Window x:Class="DSHLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek Harness"
        Width="396"
        Height="516"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F7FBFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#90A7BD"/>
        <SolidColorBrush x:Key="Accent" Color="#58A6FF"/>
        <SolidColorBrush x:Key="AccentStrong" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Danger" Color="#FF6B7D"/>
        <SolidColorBrush x:Key="Separator" Color="#24445D"/>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#142E45"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#193B59"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="CardBorder"
                CornerRadius="18"
                BorderThickness="1"
                BorderBrush="#31566F"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="6"
                                  Direction="270"
                                  Opacity="0.45"
                                  Color="#000A12"/>
            </Border.Effect>

            <Grid x:Name="ContentGrid">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#111A27" Offset="0"/>
                        <GradientStop Color="#0B1C2B" Offset="0.50"/>
                        <GradientStop Color="#071723" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid.RowDefinitions>
                    <RowDefinition Height="104"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="1"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <!-- vibrant deep-sea glow (top-right cyan) -->
                <Ellipse Width="230"
                         Height="230"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-145,-105,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#6058A6FF" Offset="0"/>
                            <GradientStop Color="#0058A6FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- vibrant deep-sea glow (bottom-left indigo) -->
                <Ellipse Width="140"
                         Height="140"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-78,0,0,-86"
                         Grid.Row="2"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#354D6BFE" Offset="0"/>
                            <GradientStop Color="#004D6BFE" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- header -->
                <Grid Grid.Row="0" Margin="20,16,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="42"
                            Height="42"
                            CornerRadius="12"
                            Background="#132C43"
                            BorderBrush="#2A5878"
                            BorderThickness="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                        <Image x:Name="AppIconImage"
                               Source="/DeepSeekHarness.ico"
                               Width="30"
                               Height="30"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <TextBlock Text="DeepSeek Harness"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource UiFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <Ellipse x:Name="StatusDot"
                                     Width="8"
                                     Height="8"
                                     Fill="#6F8A9D"
                                     Margin="0,1,7,0"/>
                            <TextBlock x:Name="StatusText"
                                       Text="Starting"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="12"/>
                            <TextBlock Text="  ·  127.0.0.1:3080"
                                       Foreground="#647B8F"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource Separator}" Opacity="0.72"/>

                <!-- actions -->
                <StackPanel Grid.Row="2" Margin="10,10,10,8">
                    <Button x:Name="OpenButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OpenButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↗"
                                       Foreground="{StaticResource Accent}"
                                       FontSize="18"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Open DeepSeek Harness"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ActionButtonStyle}"
                            Click="HarnessLogsButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="≡"
                                       Foreground="#8CC6F7"
                                       FontSize="19"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Open Harness Logs"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource ActionButtonStyle}"
                            Click="LauncherLogsButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="⌁"
                                       Foreground="#8CC6F7"
                                       FontSize="20"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Open Launcher Logs"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="SettingsButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="SettingsButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="2,0,0,0"
                                  Fill="#8CC6F7"
                                  Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.5c-1.93,0-3.5-1.57-3.5-3.5s1.57-3.5,3.5-3.5s3.5,1.57,3.5,3.5S13.93,15.5,12,15.5z"/>
                            <TextBlock Grid.Column="1"
                                       Text="Settings"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="UpdateButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="UpdateButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="2,0,0,0"
                                  Fill="#8CC6F7"
                                  Data="M19.35,10.04C18.67,6.59,15.64,4,12,4C9.11,4,6.6,5.64,5.35,8.04C2.34,8.36,0,10.91,0,14c0,3.31,2.69,6,6,6h13c2.76,0,5-2.24,5-5C24,12.36,21.95,10.22,19.35,10.04z M17,13l-5,5l-5-5h3V9h4v4H17z"/>
                            <TextBlock Grid.Column="1"
                                       Text="Update DeepSeek Harness"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Button x:Name="RestartButton"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="RestartButton_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↻"
                                       Foreground="{StaticResource Accent}"
                                       FontSize="19"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Restart DeepSeek Harness"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource Separator}" Opacity="0.72"/>

                <!-- exit -->
                <Button Grid.Row="4"
                        Margin="10,4,10,4"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="StopButton_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="×"
                                   Foreground="{StaticResource Danger}"
                                   FontSize="22"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Stop DeepSeek Harness"
                                   Foreground="#FFD6DC"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
