<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DSHLauncher</AssemblyName>
    <RootNamespace>DSHLauncher</RootNamespace>
    <ApplicationIcon>..\..\assets\DeepSeekHarness.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\DeepSeekHarness.ico" Link="DeepSeekHarness.ico" />
  </ItemGroup>
</Project>
