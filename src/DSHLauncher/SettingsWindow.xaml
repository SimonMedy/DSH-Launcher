<Window x:Class="DSHLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeepSeek Harness — Settings"
        Width="500"
        Height="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F7FBFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#90A7BD"/>
        <SolidColorBrush x:Key="TextMuted" Color="#647B8F"/>
        <SolidColorBrush x:Key="Accent" Color="#58A6FF"/>
        <SolidColorBrush x:Key="AccentStrong" Color="#4D6BFE"/>
        <SolidColorBrush x:Key="Separator" Color="#24445D"/>
        <SolidColorBrush x:Key="CardBackground" Color="#0D2235"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A5878"/>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#33FF6B7D"/>
                                <Setter Property="Foreground" Value="#FF6B7D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="#142E45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2A5878"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="#193B59"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Border x:Name="CardBorder"
                CornerRadius="18"
                BorderThickness="1"
                BorderBrush="#31566F"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24"
                                  ShadowDepth="8"
                                  Direction="270"
                                  Opacity="0.5"
                                  Color="#000A12"/>
            </Border.Effect>
            <Grid x:Name="ContentGrid">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#111A27" Offset="0"/>
                        <GradientStop Color="#0B1C2B" Offset="0.50"/>
                        <GradientStop Color="#071723" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>
                <Ellipse Width="240"
                         Height="240"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-140,-100,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5058A6FF" Offset="0"/>
                            <GradientStop Color="#0058A6FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Grid Margin="22,18,22,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                CornerRadius="10"
                                Background="#132C43"
                                BorderBrush="#2A5878"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <Image x:Name="AppIconImage"
                                   Source="/DeepSeekHarness.ico"
                                   Width="24"
                                   Height="24"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   SnapsToDevicePixels="True"
                                   UseLayoutRounding="True"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Settings"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Configure browser trust &amp; startup options"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="12"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="×"
                                Style="{StaticResource CloseButtonStyle}"
                                Click="CancelButton_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource Separator}" Opacity="0.7"/>
                    <ScrollViewer Grid.Row="2"
                                  Margin="0,14,0,14"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Trusted Authorities (Browser Trust)"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Accepted DSH Web host/IP authorities. This is not client authentication or network access control."
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11"
                                       Margin="0,3,0,8"
                                       TextWrapping="Wrap"/>
                            <Border CornerRadius="8"
                                    Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Padding="8">
                                <TextBox x:Name="TrustedHostsTextBox"
                                         Height="120"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderThickness="0"
                                         CaretBrush="{StaticResource Accent}"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="12"/>
                            </Border>
                            <TextBlock Text="Examples: my-pc.tailnet.ts.net, 100.115.92.10, host.example:443, [fd00::1234]:443"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="2,5,0,4"/>
                            <TextBlock Text="For remote access, use a trusted private network or authenticated reverse proxy. Never expose an unauthenticated Harness listener directly to the public Internet."
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="2,0,0,16"/>
                            <TextBlock Text="Additional CLI Arguments (Optional)"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Arguments are tokenized and passed directly to DSH; do not enter secrets."
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,8"/>
                            <Border CornerRadius="8"
                                    Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    Padding="8,6">
                                <TextBox x:Name="CustomArgsTextBox"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderThickness="0"
                                         CaretBrush="{StaticResource Accent}"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" Background="{StaticResource Separator}" Opacity="0.7"/>
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Button HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OpenConfigFileButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="Open config.json" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Click="CancelButton_Click"/>
                            <Button Content="Save &amp; Restart"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="SaveButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
